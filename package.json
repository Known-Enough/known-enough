{
  "name": "deal-table",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "npm run dev --workspace @deal-table/web",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:references": "node scripts/check-references.mjs",
    "check:planning": "node planning-checks/teamtable-fixture-check.mjs",
    "build": "npm run build --workspace @deal-table/web && node scripts/check-bundle.mjs",
    "check": "npm run check:references && npm run check:planning && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript-eslint": "8.70.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.63.0"
  }
}
