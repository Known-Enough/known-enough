{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyBoundedOwnedFixtureRecoveryMetadata",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::known-enough-qa-artifacts-092954139775",
      "Condition": {
        "StringEquals": { "s3:prefix": "ops01-owned/" },
        "NumericLessThanEquals": { "s3:max-keys": "1000" }
      }
    }
  ]
}
