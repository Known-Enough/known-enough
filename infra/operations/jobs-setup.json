    "output": "REAL_KERNEL_APPLICATION_STATE_JOINED_WITH_JOB_TOTAL_AND_GUARD_CAS"
  },
  "bounds": {
    "slots": 2,
    "leaseMs": 10000,
    "providerTimeoutMs": 8000,
