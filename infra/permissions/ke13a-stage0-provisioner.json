{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOnlyNamedUsEast1Bucket",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::known-enough-preview-20260927-7f94b6a1",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "092954139775",
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2000-01-01T00:00:00Z"
        },
        "Null": {
          "s3:LocationConstraint": "true"
        }
      }
    },
    {
      "Sid": "ConfigureOnlyNamedBucketReleaseRetention",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::known-enough-preview-20260927-7f94b6a1",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "092954139775",
          "aws:RequestedRegion": "us-east-1",
          "s3:ResourceAccount": "092954139775"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2000-01-01T00:00:00Z"
        }
      }
    },
    {
      "Sid": "InspectOnlyNamedBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketVersioning",
        "s3:GetLifecycleConfiguration",
        "s3:GetBucketTagging",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus"
      ],
      "Resource": "arn:aws:s3:::known-enough-preview-20260927-7f94b6a1",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "092954139775",
          "aws:RequestedRegion": "us-east-1",
          "s3:ResourceAccount": "092954139775"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2000-01-01T00:00:00Z"
        }
      }
    },
    {
      "Sid": "CreateCloudFrontResourcesOnlyDuringReviewedWindow",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:CreateOriginAccessControl"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "092954139775",
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2000-01-01T00:00:00Z"
        }
      }
    },
    {
      "Sid": "TagOnlyExactProvisionedDistribution",
      "Effect": "Allow",
      "Action": "cloudfront:TagResource",
      "Resource": "arn:aws:cloudfront::092954139775:distribution/REPLACE_WITH_PROVISIONED_DISTRIBUTION_ID",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "092954139775",
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/Project": "KnownEnough",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestTag/Stage": "preview",
          "aws:RequestTag/CleanupAfter": "2026-10-04"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2000-01-01T00:00:00Z"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project",
            "Environment",
            "Stage",
            "CleanupAfter"
          ]
        },
        "Null": {
          "aws:TagKeys": "false"
        }
      }
    }
  ]
}
